{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/butterfly.png",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    },
    "printRemaining": true,
    "width": 36
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    "disableLinewrap": true
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "\u001b[30m󵄐  \u001b[31m󵄑  \u001b[32m󵄒  \u001b[33m󵄓  \u001b[34m󵄔  \u001b[35m󵄕  \u001b[36m󵄖  \u001b[37m󵄗  \u001b[0m"
    },
    "break",
    "break",
    {
      "type": "os",
      "key": "╭─ OS:",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "├─ Kernel:",
      "keyColor": "magenta",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "├─ Window manager",
      "keyColor": "magenta",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "├─ Terminal:",
      "keyColor": "magenta"
    },
    {
      "type": "terminalfont",
      "key": "╰─ Font:",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "host",
      "key": "╭─ PC:",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "├─ CPU:",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "├─ GPU:",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key": "├─ Display:",
      "keyColor": "yellow",
      "format": "{width}x{height} @ {refresh-rate} Hz ({name})"
    },
    {
      "type": "disk",
      "key": "├─ Storage:",
      "keyColor": "yellow",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) [{filesystem}]"
    },
    {
      "type": "memory",
      "key": "├─ Memory:",
      "keyColor": "yellow"
    },
    {
      "type": "swap",
      "key": "╰─ Swap:",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "disk",
      "key": "╭─ OS Age:",
      "keyColor": "green",
      "folders": "/",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "╰─ Uptime:",
      "keyColor": "green"
    },
    "break",
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "\u001b[90m󵄘  \u001b[91m󵄙  \u001b[92m󵄚  \u001b[93m󵄛  \u001b[94m󵄜  \u001b[95m󵄝  \u001b[96m󵄞  \u001b[97m󵄟  \u001b[0m"
    }
  ]
}
