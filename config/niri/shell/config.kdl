// Pond shell integration.
// Put personal settings in ~/.config/niri/cfg/*.kdl.

spawn-sh-at-startup "qs -c pond-shell"

binds {
    Mod+Space                           repeat=false hotkey-overlay-title="Open Launcher" { spawn "/usr/bin/vicinae" "toggle"; }
    Mod+V                               repeat=false hotkey-overlay-title="Open Clipboard History" { spawn "/usr/bin/vicinae" "vicinae://launch/clipboard/history?toggle=true"; }
    Mod+ALT+L                           hotkey-overlay-title="Lock Screen" { spawn-sh "/usr/bin/qs -p /usr/share/pond-interface/lockscreen ipc call lockscreen lock || /usr/bin/qs -d -p /usr/share/pond-interface/lockscreen"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume                 allow-when-locked=true { spawn "qs" "-c" "pond-shell" "ipc" "call" "volume" "increase"; }
    XF86AudioLowerVolume                 allow-when-locked=true { spawn "qs" "-c" "pond-shell" "ipc" "call" "volume" "decrease"; }
    XF86AudioMute                        allow-when-locked=true repeat=false { spawn "qs" "-c" "pond-shell" "ipc" "call" "volume" "muteOutput"; }
    XF86AudioMicMute                     allow-when-locked=true repeat=false { spawn "qs" "-c" "pond-shell" "ipc" "call" "volume" "muteInput"; }
    XF86AudioNext                        allow-when-locked=true repeat=false { spawn "qs" "-c" "pond-shell" "ipc" "call" "media" "next"; }
    XF86AudioPrev                        allow-when-locked=true repeat=false { spawn "qs" "-c" "pond-shell" "ipc" "call" "media" "previous"; }
    XF86AudioPlay                        allow-when-locked=true repeat=false { spawn "qs" "-c" "pond-shell" "ipc" "call" "media" "playPause"; }
    XF86AudioPause                       allow-when-locked=true repeat=false { spawn "qs" "-c" "pond-shell" "ipc" "call" "media" "playPause"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                  allow-when-locked=true { spawn "qs" "-c" "pond-shell" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown                allow-when-locked=true { spawn "qs" "-c" "pond-shell" "ipc" "call" "brightness" "decrease"; }
}

cursor {
    xcursor-theme "capitaine-cursors"
    xcursor-size 24
}

gestures {
    // Keep sidebar drags from panning the tiling view at a screen edge.
    dnd-edge-view-scroll {
        max-speed 0
    }
}

// Keep the wallpaper stationary behind workspaces and the overview.
layer-rule {
    match namespace="^pond-wallpaper$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^pond-(sidebar|volume|brightness)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^pond-calendar-"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^vicinae$"
    background-effect {
        xray false
    }
}
