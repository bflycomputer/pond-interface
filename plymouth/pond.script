# A 20ms tick represents every entrance event; sprites redraw only dirty regions.
Window.SetBackgroundTopColor(0.109803922, 0.035294118, 0.098039216);
Window.SetBackgroundBottomColor(0.109803922, 0.035294118, 0.098039216);
Plymouth.SetRefreshRate(50);
clock_ms = 0;
next_event = 0;
screen_count = 0;
entrance_pending = 1;
dialog_active = 0;
dialog_prompt = "";
dialog_entry = "";
message = "";
quitting = 0;

fun scaled_image(key, width, height) {
  local.w = Math.Max(1, Math.Int(width + 0.5));
  local.h = Math.Max(1, Math.Int(height + 0.5));
  local.cache_key = key + ":" + w + ":" + h;
  if (!image_cache[cache_key]) {
    local.a = asset[key];
    if (a.crop_width) {
      local.sx = w / a.crop_width; local.sy = h / a.crop_height;
      local.im = raw[key].Scale(Math.Max(1,Math.Int(a.image_width*sx+0.5)),Math.Max(1,Math.Int(a.image_height*sy+0.5)));
      if (a.rotation) im = im.Rotate(a.rotation);
      image_cache[cache_key] = im.Crop(Math.Int(a.crop_x*sx+0.5),Math.Int(a.crop_y*sy+0.5),w,h);
    } else if (raw[key].GetWidth() == 1 && raw[key].GetHeight() == 1)
      image_cache[cache_key] = raw[key].Tile(w,h);
    else image_cache[cache_key] = raw[key].Scale(w,h);
  }
  return image_cache[cache_key];
}

fun frame_at(l,t) {
  if (mode == "shutdown") {
    local.phase=0; local.position=t % shutdown_cycle;
    while (phase+1 < shutdown_phase_count && position >= shutdown_starts[phase+1]) phase++;
    if (l.motion_period > 0)
      return phase*l.motion_count + Math.Int(t/l.motion_period)%l.motion_count;
    return phase;
  }
  if (l.palette_offset >= 0) {
    local.start = palette_start + l.palette_offset;
    if (t < start) return 0;
    return (Math.Int((t-start)/palette_period)+1) % l.count;
  }
  if (l.period > 0) return Math.Int(Math.Max(0,t-l.start)/l.period) % l.count;
  return 0;
}

fun visible_at(l,t) {
  return t >= l.start && (l.end < 0 || t < l.end);
}

fun find_next_event(t) {
  if (mode == "shutdown") {
    local.start=Math.Int(t/shutdown_cycle)*shutdown_cycle;
    local.next=start+shutdown_cycle;
    for (local.i=0; i<shutdown_phase_count; i++)
      if (start+shutdown_starts[i]>t) next=Math.Min(next,start+shutdown_starts[i]);
    for (local.i=0; i<layer_count; i++) {
      local.period=layers[i].motion_period;
      if (period>0) next=Math.Min(next,(Math.Int(t/period)+1)*period);
    }
    return next;
  }
  local.next = t + 2000;
  for (local.i=0; i<layer_count; i++) {
    local.l = layers[i];
    if (l.start > t) next = Math.Min(next,l.start);
    if (l.end > t) next = Math.Min(next,l.end);
    if (l.period > 0 && visible_at(l,t)) {
      local.boundary = l.start + (Math.Int((t-l.start)/l.period)+1)*l.period;
      if (l.end < 0 || boundary < l.end) next = Math.Min(next,boundary);
    }
    if (l.palette_offset >= 0) {
      local.start = palette_start + l.palette_offset;
      local.boundary = start;
      if (t >= start) boundary = start + (Math.Int((t-start)/palette_period)+1)*palette_period;
      next = Math.Min(next,boundary);
    }
  }
  return next;
}

fun prepare_screen(index, origin, width, height) {
  global.entrance_pending=1;
  local.s = [];
  s.width=width; s.height=height; s.origin=origin;
  s.scale=Math.Min(width/1920,height/1080);
  s.x=origin+(width-1920*s.scale)/2;
  s.y=(height-1080*s.scale)/2;
  for (local.i=0; i<layer_count; i++) {
    local.l=layers[i];
    local.n=[];
    n.sprite=Sprite(); n.sprite.SetOpacity(0); n.sprite.SetZ(l.z);
    n.last_frame=-1; n.last_visible=-1;
    for (local.f=0; f<l.count; f++) {
      local.key=l.frames[f];
      local.a=asset[key];
      local.w=l.width; local.h=l.height;
      if (a.width) { w=a.width; h=a.height; }
      n.images[f]=scaled_image(key,w*s.scale,h*s.scale);
      n.x[f]=Math.Int(s.x+(l.x+a.dx)*s.scale+0.5);
      n.y[f]=Math.Int(s.y+(l.y+a.dy)*s.scale+0.5);
      if (l.anchor == "top") n.y[f]=0;
      if (l.anchor == "bottom") n.y[f]=height-n.images[f].GetHeight();
    }
    s.nodes[i]=n;
  }
  s.shield=Sprite();
  s.shield_ready=0;
  s.shield.SetPosition(origin,0,9000); s.shield.SetOpacity(0);
  s.prompt=Sprite(); s.prompt.SetZ(9001); s.prompt.SetOpacity(0);
  s.entry=Sprite(); s.entry.SetZ(9001); s.entry.SetOpacity(0);
  s.message=Sprite(); s.message.SetZ(9002); s.message.SetOpacity(0);
  global.screens[index]=s;
}

# Plymouth normally overlaps monitor coordinate spaces. Separate them so each
# monitor gets its own aspect-preserving scene, with no cross-monitor clipping.
fun check_layout() {
  local.changed=0; local.count=0; local.origin=0;
  while (Window.GetWidth(count)) {
    local.w=Window.GetWidth(count); local.h=Window.GetHeight(count);
    local.s=screens[count];
    if (!s || s.width != w || s.height != h || s.origin != origin) {
      if (s) {
        for(local.i=0;i<layer_count;i++) s.nodes[i].sprite.SetOpacity(0);
        s.shield.SetOpacity(0); s.prompt.SetOpacity(0); s.entry.SetOpacity(0); s.message.SetOpacity(0);
      }
      prepare_screen(count,origin,w,h); changed=1;
    }
    if (Window.GetX(count) != origin || Window.GetY(count) != 0) changed=1;
    Window.SetX(count,origin); Window.SetY(count,0);
    origin += w+1024; count++;
  }
  for(local.i=count;i<screen_count;i++) {
    local.s=screens[i];
    for(local.j=0;j<layer_count;j++) s.nodes[j].sprite.SetOpacity(0);
    s.shield.SetOpacity(0); s.prompt.SetOpacity(0); s.entry.SetOpacity(0); s.message.SetOpacity(0);
    global.screens[i]=NULL; changed=1;
    global.entrance_pending=1;
  }
  global.screen_count=count;
  return changed;
}

fun draw_scene(t) {
  for(local.i=0;i<layer_count;i++) {
    local.l=layers[i]; local.f=frame_at(l,t); local.v=visible_at(l,t);
    if (mode != "boot" && l.id == "initializing") v=0;
    for(local.d=0;d<screen_count;d++) {
      local.n=screens[d].nodes[i];
      if (v && (n.last_key != l.frames[f] || !n.last_visible)) {
        n.sprite.SetImage(n.images[f]); n.sprite.SetX(n.x[f]); n.sprite.SetY(n.y[f]);
      }
      if (v != n.last_visible || (v && n.last_key != l.frames[f])) {
        local.opacity=0;
        if(v) opacity=asset[l.frames[f]].opacity;
        n.sprite.SetOpacity(opacity);
      }
      n.last_key=l.frames[f]; n.last_frame=f; n.last_visible=v;
    }
  }
}

fun fit_text(text, width, height, red, green, blue, font) {
  local.im=Image.Text(text,red,green,blue,1,font,"center");
  local.scale=Math.Min(1,Math.Min(width/Math.Max(1,im.GetWidth()),height/Math.Max(1,im.GetHeight())));
  if(scale<1) im=im.Scale(Math.Max(1,Math.Int(im.GetWidth()*scale)),Math.Max(1,Math.Int(im.GetHeight()*scale)));
  return im;
}

fun draw_dialog() {
  for(local.d=0;d<screen_count;d++) {
    local.s=screens[d];
    s.shield.SetOpacity(dialog_active); s.prompt.SetOpacity(dialog_active); s.entry.SetOpacity(dialog_active);
    if(dialog_active) {
      if(!s.shield_ready) {
        s.shield.SetImage(scaled_image("solid-background",s.width,s.height));
        s.shield_ready=1;
      }
      local.im=fit_text(dialog_prompt,s.width*0.88,s.height*0.22,0.796,0.651,0.969,"DejaVu Sans " + Math.Max(20,Math.Int(20*s.scale)));
      s.prompt.SetImage(im); s.prompt.SetX(s.origin+(s.width-im.GetWidth())/2); s.prompt.SetY(s.height*0.40-im.GetHeight()/2);
      local.im=fit_text(dialog_entry,s.width*0.8,s.height*0.15,0.808,0.941,0.345,"DejaVu Sans Mono " + Math.Max(20,Math.Int(20*s.scale)));
      s.entry.SetImage(im); s.entry.SetX(s.origin+(s.width-im.GetWidth())/2); s.entry.SetY(s.height*0.55-im.GetHeight()/2);
    }
    local.text=message;
    # Routine boot messages stay in the logs; keep the artwork unobstructed.
    if (mode == "boot" && !dialog_active) text="";
    if (mode != "boot" && mode != "shutdown" && text == "" && !dialog_active) {
      text="Shutting down";
      if(mode=="reboot") text="Restarting";
      if(mode=="updates" || mode=="system-upgrade") text="Installing updates";
      if(mode=="firmware-upgrade") text="Updating firmware";
      if(mode=="system-reset") text="Resetting system";
    }
    s.message.SetOpacity(text != "");
    if(text != "") {
      local.im=fit_text(text,s.width*0.9,s.height*0.12,0.796,0.651,0.969,"DejaVu Sans " + Math.Max(16,Math.Int(16*s.scale)));
      s.message.SetImage(im); s.message.SetX(s.origin+(s.width-im.GetWidth())/2); s.message.SetY(s.height*0.78-im.GetHeight()/2);
    }
  }
}

fun display_normal() {
  global.dialog_active=0; global.dialog_prompt=""; global.dialog_entry="";
  draw_dialog();
}
fun display_password(prompt,bullets) {
  global.dialog_active=1; global.dialog_prompt=prompt;
  if(prompt=="") global.dialog_prompt="Unlock disk";
  global.dialog_entry="";
  for(local.i=0;i<Math.Min(64,bullets);i++) global.dialog_entry += "•";
  draw_dialog();
}
fun display_question(prompt,entry) {
  global.dialog_active=1; global.dialog_prompt=prompt; global.dialog_entry=entry; draw_dialog();
}
fun display_prompt(prompt,entry,is_secret) {
  if(is_secret) display_password(prompt,entry.Length());
  else display_question(prompt,entry);
}
fun display_message(text) { global.message=text; draw_dialog(); }
fun hide_message(text) { if(message==text) { global.message=""; draw_dialog(); } }
fun system_update(progress) { global.message="Installing updates: " + progress + "%"; draw_dialog(); }
fun quit() {
  global.quitting=1;
  # No end animation or delay: immediately leave a complete frame for handoff.
  if (mode == "shutdown") draw_scene(clock_ms);
  else draw_scene(Math.Max(clock_ms,settled_at));
}

# A DRM handover may replace a display with another of the same size between
# refreshes. Latch the native notification rather than relying on dimensions.
fun display_hotplug() { global.entrance_pending=1; }

fun refresh() {
  if(quitting) return;
  local.changed=check_layout();
  if(!screen_count) {
    # Never consume the entrance while there is no display to draw it on.
    if(mode == "boot") { global.clock_ms=0; global.next_event=0; }
    global.entrance_pending=1;
    return;
  }
  if(entrance_pending) {
    if(mode == "boot") { global.clock_ms=0; global.next_event=0; }
    global.entrance_pending=0;
    changed=1;
  }
  if (mode != "boot" && mode != "shutdown" && clock_ms < settled_at) global.clock_ms=settled_at;
  if(changed || clock_ms >= next_event) {
    draw_scene(clock_ms);
    global.next_event=find_next_event(clock_ms);
  }
  if(changed) draw_dialog();
  global.clock_ms += 20;
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayHotplugFunction(display_hotplug);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayPromptFunction(display_prompt);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
Plymouth.SetSystemUpdateFunction(system_update);
Plymouth.SetQuitFunction(quit);
