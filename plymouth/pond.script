# Scene coordinates use a 1920x1080 canvas; times are milliseconds.
settled_at = 1620;
palette_start = 3620;
palette_period = 2000;
raw = []; asset = []; layers = []; screens = []; image_cache = [];
layer_count = 0;
mode = Plymouth.GetMode();

fun add_asset(key, file, opacity, dx, dy, width, height) {
  global.raw[key] = Image(file);
  global.asset[key].opacity = opacity;
  global.asset[key].dx = dx;
  global.asset[key].dy = dy;
  global.asset[key].width = width;
  global.asset[key].height = height;
}

fun add_layer(id, frames, x, y, width, height, z, start, end, period, palette_offset, anchor) {
  local.l = [];
  l.id = id; l.frames = frames;
  l.x = x; l.y = y; l.width = width; l.height = height; l.z = z;
  l.start = start; l.end = end; l.period = period;
  l.palette_offset = palette_offset; l.anchor = anchor;
  l.count = 0;
  while (frames[l.count]) l.count++;
  global.layers[layer_count++] = l;
}

add_asset("solid-background", "solid-background.png", 1, 0, 0, 0, 0);

# Shutdown V2 from taha-prototypes/pond-plymouth-prototype/shutdown-v2/scene.json.
# Decode only the selected scene's artwork; the prompt background is shared.
if (mode == "shutdown") {
  shutdown_cycle = 2160;
  shutdown_starts = [0, 160, 320, 480, 640, 800, 960, 1120,
                     1280, 1400, 1500, 1600, 1720, 1840];
  shutdown_phase_count = 14;
  shutdown_assets = ["flower-off", "flower-on", "shutting-off", "shutting-on",
                     "shutting-edge", "down-off", "down-on", "down-edge",
                     "circle-off", "circle-on", "icon-1", "icon-2", "icon-3",
                     "icon-4", "icon-5", "icon-6"];
  for (i=0; shutdown_assets[i]; i++) {
    key=shutdown_assets[i];
    add_asset(key, "shutdown-" + key + ".png", 1, 0, 0, 0, 0);
  }

  # Paired flowers light from the outer edges toward the central text.
  for (side=0; side<2; side++) {
    for (row=0; row<8; row++) {
      frames=[];
      for (phase=0; phase<shutdown_phase_count; phase++) frames[phase]="flower-off";
      frames[row]="flower-on";
      y=40+row*40; id="top-";
      if (side==1) { y=1010-row*40; id="bottom-"; }
      for (column=0; column<2; column++)
        add_layer(id+row+"-"+column, frames, 924+column*42, y, 30, 30,
                  1, 0, -1, 0, -1, "center");
    }
  }

  # The 500ms orientation clock runs continuously across highlight cycles.
  frames=[];
  for (phase=0; phase<shutdown_phase_count; phase++) {
    upright="icon-1"; rotated="icon-2";
    if (phase>=9 && phase<=11) { upright="icon-5"; rotated="icon-3"; }
    if (phase==12) { upright="icon-6"; rotated="icon-4"; }
    frames[phase*2]=upright; frames[phase*2+1]=rotated;
  }
  add_layer("shutdown-loader", frames, 651.5, 479.5, 121, 121,
            2, 0, -1, 0, -1, "center");
  layers[layer_count-1].motion_period=500;
  layers[layer_count-1].motion_count=2;
