  frames[13]="circle-on";
  add_layer("corner-tl", frames, 39.5, 39.5, 41, 41, 1, 0, -1, 0, -1, "center");
  add_layer("corner-tr", frames, 1839.5, 39.5, 41, 41, 1, 0, -1, 0, -1, "center");
  add_layer("corner-bl", frames, 39.5, 999.5, 41, 41, 1, 0, -1, 0, -1, "center");
  add_layer("corner-br", frames, 1839.5, 999.5, 41, 41, 1, 0, -1, 0, -1, "center");
