GRUB_DISTRIBUTOR="Pond"
GRUB_TIMEOUT=3
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=0 systemd.show_status=false udev.log_level=err rd.udev.log_level=err vt.global_cursor_default=0"
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_DISABLE_RECOVERY=true
GRUB_THEME="/usr/share/grub/themes/pond/theme.txt"
GRUB_TOP_LEVEL="/boot/vmlinuz-linux-pond"
GRUB_DISABLE_SUBMENU=true
GRUB_DISABLE_OS_PROBER=false
